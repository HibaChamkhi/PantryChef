# Copy to .env and fill in to use Claude for recipe generation and photo recognition.
# Leave empty to use the built-in offline chef and photo simulation.
#
# WARNING: EXPO_PUBLIC_ variables are inlined into the app bundle and can be
# extracted from the binary. Fine for personal builds; use a backend proxy for
# a public release.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_CLAUDE_MODEL=claude-opus-5
